{
  "manifest_version": 3,
  "name": "Authenticator",
  "version": "1.0.1",
  "description": "基于时间的TOTP两步验证码生成器，数据全部存储在本地",
  "permissions": ["storage", "activeTab"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
